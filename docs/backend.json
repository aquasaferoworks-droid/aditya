
{
  "entities": {
    "Video": {
      "title": "Video",
      "description": "A cinematic video project entry.",
      "type": "object",
      "properties": {
        "category": { "type": "array", "items": { "type": "string" } },
        "youtubeId": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "type": { 
          "type": "string"
        },
        "upperText": { "type": "string" },
        "lowerText": { "type": "string" },
        "upperTextSize": { "type": "number", "default": 30 },
        "lowerTextSize": { "type": "number", "default": 20 },
        "meta": { "type": "string" },
        "award": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["youtubeId", "type"]
    },
    "ContactSettings": {
      "title": "Contact Settings",
      "description": "Global settings for contact information, social links, and branding.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "locations": { "type": "string" },
        "formHeading": { "type": "string" },
        "formDescription": { "type": "string" },
        "instagram": { "type": "string" },
        "youtube": { "type": "string" },
        "whatsapp": { "type": "string" },
        "facebook": { "type": "string" },
        "twitter": { "type": "string" },
        "logoSize": { "type": "number", "default": 24 }
      }
    },
    "ContactSubmission": {
      "title": "Contact Submission",
      "description": "Information submitted via the contact form by potential clients.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "type": { "type": "string" },
        "brief": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email"]
    },
    "AdminConfig": {
      "title": "Admin Config",
      "description": "Tracking the application initialization state.",
      "type": "object",
      "properties": {
        "initialized": { "type": "boolean" },
        "adminEmail": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/videos/{videoId}": {
      "schema": "Video",
      "description": "Collection of all video projects."
    },
    "/settings/contact": {
      "schema": "ContactSettings",
      "description": "Single document for global contact settings."
    },
    "/settings/admin": {
      "schema": "AdminConfig",
      "description": "App initialization state."
    },
    "/submissions/{submissionId}": {
      "schema": "ContactSubmission",
      "description": "Collection of all client contact submissions."
    }
  }
}
